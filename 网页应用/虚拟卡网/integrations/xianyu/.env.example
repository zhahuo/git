# 复制为 .env 后填写真实值；.env 已被上游 .gitignore 排除，不会提交到仓库。

# Web 服务
API_HOST=0.0.0.0
API_PORT=8090

# 数据库与日志（相对 integrations/xianyu/ 目录）
DB_PATH=data/xianyu_data.db
SQL_LOG_ENABLED=true
SQL_LOG_LEVEL=INFO
LOG_LEVEL=INFO

# 敏感信息加密密钥（Fernet 格式：32 字节 url-safe base64）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=replace-with-a-fernet-base64-key

# 与上游 docker-compose 兼容的配置占位；本地首次登录仍使用 admin / admin123，
# 登录后请在后台“修改密码”中立即更换。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET_KEY=replace-with-a-long-random-string

# 浏览器：优先使用系统 Edge，无需下载 Playwright Chromium
BROWSER_CHANNEL=msedge
# 可选：显式指定浏览器可执行文件
# BROWSER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# 单测试账号 Cookie（可选，与后台“账号管理”等价；真实 Cookie 不提交）
COOKIES_STR=

# AI 回复占位（实际配置在后台“AI回复设置”中按账号保存）
AI_REPLY_ENABLED=false
DEFAULT_AI_MODEL=qwen-plus
DEFAULT_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_API_TYPE=openai_compatible

# 通知渠道占位（后台“通知渠道”中保存，任选其一）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# 模块7 自动发货桥接占位（本模块不调用，仅预留）
CARD_API_BASE_URL=http://127.0.0.1:3000
INTEGRATION_API_TOKEN=
